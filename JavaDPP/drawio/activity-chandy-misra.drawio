<mxfile host="Electron" agent="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/28.2.5 Chrome/138.0.7204.251 Electron/37.6.1 Safari/537.36" version="28.2.5">
  <diagram name="Chandy-Misra Algorithm" id="act-chandy">
    <mxGraphModel dx="1637" dy="1057" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1300" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Chandy/Misra Message Passing Algorithm (per Philosopher thread)" style="text;html=1;fontSize=16;fontStyle=1;align=center;fillColor=none;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="123" y="10" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="check_cycles" value="cyclesCompleted &amp;lt;&lt;br&gt;targetCycles?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="230" y="120" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="think" value="State = THINKING&lt;br&gt;sleepProcessing(100..500ms)&lt;br&gt;(polls inbox every 50ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="215" y="240" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="hungry" value="State = HUNGRY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="230" y="320" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="check_forks" value="Hold both&lt;br&gt;forks?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="245" y="400" width="110" height="80" as="geometry" />
        </mxCell>
        <mxCell id="send_req" value="Send REQUEST for&lt;br&gt;missing fork(s) via queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="430" y="405" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="wait_reply" value="Poll inbox (50ms timeout);&lt;br&gt;process REQUEST or FORK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="430" y="495" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="receive_fork" value="FORK msg: update held state;&lt;br&gt;REQUEST msg: defer or yield" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="430" y="585" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="eat" value="State = EATING&lt;br&gt;sleepProcessing(100..500ms)&lt;br&gt;(polls inbox every 50ms)&lt;br&gt;Mark both forks DIRTY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="203" y="530" width="195" height="60" as="geometry" />
        </mxCell>
        <mxCell id="check_deferred" value="Deferred requests&lt;br&gt;pending?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="225" y="660" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="send_fork" value="Clean dirty fork,&lt;br&gt;send to requester" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="430" y="675" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="TZAFO_28ImcsfsjC03oe-4" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;endArrow=none;endFill=0;dashed=1;" parent="1" source="note1" target="eat" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="If THINKING and holding a&lt;br&gt;dirty fork, yield it immediately.&lt;br&gt;EATING or HUNGRY always&lt;br&gt;defers until after eating." style="shape=note;size=15;fillColor=#ffff88;strokeColor=#36393d;fontSize=10;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="-10" y="450" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="TZAFO_28ImcsfsjC03oe-5" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0;entryDx=0;entryDy=0;exitX=0;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;endArrow=none;endFill=0;dashed=1;" parent="1" source="note2" target="receive_fork" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="No shared locks on forks.&lt;br&gt;All coordination via&lt;br&gt;BlockingQueue messages" style="shape=note;size=15;fillColor=#ffff88;strokeColor=#36393d;fontSize=10;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="660" y="500" width="140" height="60" as="geometry" />
        </mxCell>
